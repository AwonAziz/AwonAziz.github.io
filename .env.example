# Environment
# Copy to `.env` for local work, or set these in your host's dashboard.
# Vite only exposes vars prefixed with VITE_ to the client bundle - never put a
# secret in one.

# Absolute origin, used for the canonical link and the OG/JSON-LD payload.
#   GitHub Pages user site:    https://awonaziz.github.io
#   GitHub Pages project site: https://awonaziz.github.io/devfolio
#   Cloudflare Pages:          https://devfolio.pages.dev
VITE_SITE_URL=https://awonaziz.github.io

# Sub-path the site is served from. LEAVE EMPTY unless the host serves from a
# sub-path - the default "./" already handles GitHub Pages project sites
# correctly and is safer than an absolute path.
#   GitHub Pages project site only:  VITE_BASE_PATH=/devfolio/
VITE_BASE_PATH=

# Optional: canonical analytics endpoint, reserved for src/hooks/use-seo.ts
VITE_ANALYTICS_ID=
