{
  // -------------------------------------------------------------------------
  //  Cloudflare Pages
  // -------------------------------------------------------------------------
  //  Connect the repo in the Cloudflare dashboard and these settings are picked
  //  up automatically. If you are deploying by hand instead:
  //
  //    npm run build
  //    npx wrangler pages deploy dist --project-name devfolio
  //
  //  Build settings in the dashboard. These must match exactly or the build
  //  will silently produce an empty dist:
  //    Build command:          npm run build
  //    Build output directory: dist
  //    Node version:           22
  //    Environment variables:  VITE_SITE_URL
  //
  //  Pages serves the project at the domain you assign, so no base path is
  //  needed. `base: "./"` in vite.config.ts resolves against the root.
  //
  //  Keys deliberately absent, because Pages rejects them outright rather than
  //  warning:
  //    `observability`  Workers-only. Including it fails the whole build with
  //                     "Configuration file for Pages projects does not
  //                     support observability".
  //    `workers_dev`    Workers-only.
  //    `assets`         Workers (Static Assets) only. Pages uses
  //                     `pages_build_output_dir` instead.
  // -------------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devfolio",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "dist"
}
